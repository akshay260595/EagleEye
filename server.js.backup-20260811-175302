const clientCache = {};


function getClients(region) {

  if (
    clientCache[region]
  ) {

    return clientCache[region];

  }


  const cfg = {
    region
  };


  clientCache[region] = {

    ce:
      new CostExplorerClient({
        region: 'us-east-1'
      }),

    ec2:
      new EC2Client(cfg),

    s3:
      new S3Client(cfg),

    sts:
      new STSClient(cfg),

