async function fetchVolumes(ec2) {

  try {

    let volumes = [];

    let nextToken;


    do {

      const response =
        await ec2.send(
          new DescribeVolumesCommand({

            MaxResults:
              500,

            NextToken:
              nextToken

          })
        );


      volumes.push(
        ...(
          response.Volumes ||
          []
        )
      );


      nextToken =
        response.NextToken;


    } while (
      nextToken
    );


    return {

      total:
        volumes.length,

      gp2:
        volumes.filter(
          volume =>
            volume.VolumeType ===
            'gp2'
        ).length,

      gp3:
        volumes.filter(
          volume =>
            volume.VolumeType ===
            'gp3'
        ).length,

      unused:
        volumes.filter(
          volume =>
            volume.State ===
            'available'
        ).length,

      gp2Gb:
        volumes
          .filter(
            volume =>
              volume.VolumeType ===
              'gp2'
          )
          .reduce(
            (
              sum,
              volume
            ) =>
              sum + volume.Size,
            0
          )

    };

  } catch (error) {

    console.warn(
      'Volumes:',
      error.message
    );


    return {

      total: 0,

      gp2: 0,

      gp3: 0,

      unused: 0,

      gp2Gb: 0

    };

  }
}


