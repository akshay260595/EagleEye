 * RDS
 * ============================================================
 */

async function fetchRDSStats(rds) {

  try {

    let instances = [];

    let marker;


    do {

      const response =
        await rds.send(
          new DescribeDBInstancesCommand({

            Marker:
              marker,

            MaxRecords:
              100

          })
        );


      instances.push(
        ...(
          response.DBInstances ||
          []
        )
      );


      marker =
        response.Marker;


    } while (
      marker
    );


    const available =
      instances.filter(
        instance =>
          instance.DBInstanceStatus ===
          'available'
      ).length;


    const stopped =
      instances.filter(
        instance =>
          instance.DBInstanceStatus ===
          'stopped'
      ).length;


    const engines = {};


    for (
      const instance of instances
    ) {

      const engine =
        instance.Engine ||
        'unknown';


      engines[engine] =
        (
          engines[engine] ||
          0
        ) + 1;

    }


    const multiAZ =
      instances.filter(
        instance =>
          instance.MultiAZ
      ).length;


    const nonMultiAZ =
      instances.length -
      multiAZ;


    const gp2Storage =
      instances.filter(
        instance =>
          instance.StorageType ===
          'gp2'
      ).length;


    const stoppedIds =
      instances
        .filter(
          instance =>
            instance.DBInstanceStatus ===
            'stopped'
        )
        .map(
          instance =>
            instance.DBInstanceIdentifier
        );


    return {

      total:
        instances.length,

      available,

      stopped,

      engines,

      multiAZ,

      nonMultiAZ,

      gp2Storage,

      stoppedIds,

      instances:
        instances
          .filter(
            instance =>
              instance.DBInstanceStatus ===
              'available'
          )
          .map(
            instance => ({

              identifier:
                instance.DBInstanceIdentifier,

              instanceClass:
                instance.DBInstanceClass,

              engine:
                instance.Engine,

              status:
                instance.DBInstanceStatus,

              multiAZ:
                instance.MultiAZ,

              storageType:
                instance.StorageType

            })
          )

    };

  } catch (error) {

    console.warn(
      'RDS:',
      error.message
    );


    return {

      total: 0,

      available: 0,

      stopped: 0,

      engines: {},

      multiAZ: 0,

      nonMultiAZ: 0,

      gp2Storage: 0,

      stoppedIds: [],

      instances: []

    };

  }
}


/*
 * ============================================================
 * CLOUDWATCH IDLE ANALYSIS
 * ============================================================
 */

async function fetchIdleResources(
  region,
  ec2Instances,
  rdsInstances
) {

  console.log(
    `CloudWatch idle analysis: ${ec2Instances.length} EC2, ${rdsInstances.length} RDS`
  );


  const idleEC2 = [];

  const idleRDS = [];


  /*
   * EC2
   */

  for (
    const instance of ec2Instances
  ) {

    try {

      const metrics =
        await getEC2IdleMetrics(
          region,
          instance.instanceId,
          30
        );


      if (
        isEC2Idle(metrics)
      ) {

        idleEC2.push({

          ...instance,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          maxCpu:
            Number(
              metrics.maxCpu.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          avgDiskReadOps:
            Number(
              metrics.avgDiskReadOps.toFixed(2)
            ),

          avgDiskWriteOps:
            Number(
              metrics.avgDiskWriteOps.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });

      }

    } catch (error) {

      console.warn(
        `EC2 CloudWatch failed for ${instance.instanceId}:`,
        error.message
      );

    }

  }


  /*
   * RDS
   */

  for (
    const database of rdsInstances
  ) {

    try {

      const metrics =
        await getRDSIdleMetrics(
          region,
          database.identifier,
          30
        );


      if (
        isRDSIdle(metrics)
      ) {

        idleRDS.push({

          ...database,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          avgConnections:
            Number(
              metrics.avgConnections.toFixed(2)
            ),

          avgReadIOPS:
            Number(
              metrics.avgReadIOPS.toFixed(2)
            ),

          avgWriteIOPS:
            Number(
              metrics.avgWriteIOPS.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });

      }

    } catch (error) {

      console.warn(
        `RDS CloudWatch failed for ${database.identifier}:`,
        error.message
      );

    }

  }


  return {

    ec2:
      idleEC2,

    rds:
      idleRDS

  };

}


