async function ceCostByService(
  ce,
  start,
  end
) {

  try {

    const response =
      await ce.send(
        new GetCostAndUsageCommand({

          TimePeriod: {
            Start: start,
            End: end
          },

          Granularity:
            'MONTHLY',

          Metrics: [
            'UnblendedCost'
          ],

          GroupBy: [
            {
              Type:
                'DIMENSION',

              Key:
                'SERVICE'
            }
          ]

        })
      );


    return (
      response.ResultsByTime || []
    )
      .flatMap(
        r =>
          r.Groups || []
      )
      .reduce(
        (
          acc,
          group
        ) => {

          const cost =
            parseFloat(
              group.Metrics
                .UnblendedCost
                .Amount
            );


          if (
            cost > 0.005
          ) {

            const service =
              group.Keys[0];


            acc[service] =
              (
                acc[service] || 0
              ) + cost;

          }


          return acc;

        },
        {}
      );

  } catch (error) {

    console.warn(
      'CE services:',
      error.message
    );


    return {};

  }
}


