async function fetchEC2Stats(ec2) {

  try {

    let instances = [];

    let nextToken;


    do {

      const response =
        await ec2.send(
          new DescribeInstancesCommand({

            MaxResults:
              1000,

            NextToken:
              nextToken

          })
        );


      instances.push(
        ...(
          response.Reservations
            ?.flatMap(
              reservation =>
                reservation.Instances
            ) || []
        )
      );


      nextToken =
        response.NextToken;


    } while (
      nextToken
    );


    const runningInstances =
      instances.filter(
        instance =>
          instance.State?.Name ===
          'running'
      );


    return {

      total:
        instances.length,

      running:
        runningInstances.length,

      stopped:
        instances.filter(
          instance =>
            [
              'stopped',
              'stopping'
            ].includes(
              instance.State?.Name
            )
        ).length,

      types:
        [
          ...new Set(
            instances.map(
              instance =>
                instance.InstanceType
            )
          )
        ].slice(
          0,
          5
        ),

      instances:
        runningInstances.map(
          instance => ({

            instanceId:
              instance.InstanceId,

            instanceType:
              instance.InstanceType,

            state:
              instance.State?.Name,

            tags:
              Object.fromEntries(
                (
                  instance.Tags ||
                  []
                ).map(
                  tag => [
                    tag.Key,
                    tag.Value
                  ]
                )
              )

          })
        )

    };

  } catch (error) {

    console.warn(
      'EC2:',
      error.message
    );


    return {

      total: 0,

      running: 0,

      stopped: 0,

      types: [],

      instances: []

    };

  }
}


