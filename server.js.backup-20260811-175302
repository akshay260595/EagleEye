async function fetchAllData(
  region,
  year,
  month
) {

  const {
    ce,
    ec2,
    s3,
    sts,
    elb,
    rds
  } =
    getClients(region);


  const now =
    new Date();


  const billingYear =
    year ||
    now.getFullYear();


  const billingMonth =
    month !== undefined &&
    month !== null

      ? month

      : now.getMonth();


  console.log(
    `Fetching — region:${region} year:${billingYear} month:${billingMonth}`
  );


  const selected =
    monthRange(
      billingYear,
      billingMonth
    );


  const previous =
    billingMonth === 0

      ? monthRange(
          billingYear - 1,
          11
        )

      : monthRange(
          billingYear,
          billingMonth - 1
        );


  previous.end =
    fmtDate(
      new Date(
        billingYear,
        billingMonth,
        1
      )
    );


  const previous2 =
    billingMonth <= 1

      ? monthRange(
          billingYear - 1,
          billingMonth === 0
            ? 10
            : 11
        )

      : monthRange(
          billingYear,
          billingMonth - 2
        );


  previous2.end =
    fmtDate(
      new Date(
        billingYear,
        billingMonth - 1,
        1
      )
    );


  const [
    identity,
    selectedMap,
    previousMap,
    previous2Map,
    monthlyData,
    ec2Stats,
    elasticIPs,
    volumes,
    vpcStats,
    albStats,
    s3Buckets,
    rdsStats
  ] =
    await Promise.all([

      sts
        .send(
          new GetCallerIdentityCommand({})
        )
        .catch(
          () => ({
            Account:
              'N/A'
          })
        ),

      ceCostByService(
        ce,
        selected.start,
        selected.end
      ),

      ceCostByService(
        ce,
        previous.start,
        previous.end
      ),

      ceCostByService(
        ce,
        previous2.start,
        previous2.end
      ),

      ceMonthlyTotals(
        ce,
        billingYear
      ),

      fetchEC2Stats(
        ec2
      ),

      fetchElasticIPs(
        ec2
      ),

      fetchVolumes(
        ec2
      ),

      fetchVPCStats(
        ec2
      ),

      fetchALBStats(
        elb
      ),

      fetchS3Count(
        s3
      ),

      fetchRDSStats(
        rds
      )

    ]);


  const services =
    toList(
      selectedMap
    );


  const lastMonthServices =
    toList(
      previousMap
    );


  const twoMonthsAgoServices =
    toList(
      previous2Map
    );


  const currentMonthTotal =
    parseFloat(
      services
        .reduce(
          (
            sum,
            item
          ) =>
            sum + item.cost,
          0
        )
        .toFixed(2)
    );


  /*
   * ============================================================
   * CLOUDWATCH IDLE
   * ============================================================
   */

  const idleResources =
    await fetchIdleResources(

      region,

      ec2Stats.instances ||
        [],

      rdsStats.instances ||
        []

    );


  /*
   * ============================================================
   * FINOPS
   * ============================================================
   */

  const finops =
    await analyzeEBS(
      ec2
    );


  /*
   * EBS recommendations include:
   *
   * - GP2 -> GP3
   * - Unattached EBS
   * - AMI >90 days
   * - Snapshot >90 days
   * - Orphaned snapshots
   */

  const finopsRecommendations =
    buildEBSRecommendations(
      finops
    );


  const MONTH_NAMES = [

    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'

  ];


  const billingPeriod =
    selected.isCurrentMonth

      ? `${MONTH_NAMES[billingMonth]} 1 – ${now.getDate()} (MTD)`

      : `${MONTH_NAMES[billingMonth]} ${billingYear} (Full Month)`;


  const infraStats = {

    ec2:
      ec2Stats,

    elasticIPs,

    volumes,

    s3Buckets,

    rds:
      rdsStats,

    vpcs:
      vpcStats.vpcs,

    subnets:
      vpcStats.subnets,

    natGateways:
      vpcStats.natGateways,

    internetGateways:
      vpcStats.internetGateways,

    securityGroups:
      vpcStats.securityGroups,

    keyPairs:
      vpcStats.keyPairs,

    alb:
      albStats

  };


  const data = {

    accountId:
      identity.Account,

    billingPeriod,

    region,

    billingYear,

    billingMonth,

    isCurrentMonth:
      selected.isCurrentMonth,

    currentMonthTotal,

    dateRange: {

      start:
        selected.displayStart,

      end:
        selected.displayEnd

    },

    prevMonthRange: {

      start:
        previous.start,

      end:
        previous.end

    },

    prev2MonthRange: {

      start:
        previous2.start,

      end:
        previous2.end

    },

    services,

    lastMonthServices,

    twoMonthsAgoServices,

    monthlyData,

    infraStats,


    /*
     * CloudWatch idle resources
     */
    idleResources,


    /*
     * ========================================================
     * FINOPS OPTIMIZATION
     * ========================================================
     *
     * Keep EBS separately.
     *
     * Also expose AMI and Snapshot sections
     * directly so the dashboard can consume
     * them easily.
     */

    optimization: {

      ebs:
        finops,

      ami:
        finops.ami || {

          total: 0,

          olderThan90Days: 0,

          candidates: []

        },

      snapshots:
        finops.snapshots || {

          total: 0,

          olderThan90Days: 0,

          orphaned: 0,

          oldOrphaned: 0,

          candidates: [],

          orphanedSnapshots: [],

          oldOrphanedSnapshots: [],

          olderThan90DaysEstimatedMonthlyCost: 0,

          orphanedEstimatedMonthlyCost: 0,

          cleanupEstimatedMonthlyCost: 0

        }

    },


    fetchedAt:
      new Date().toISOString()

  };


  /*
   * ============================================================
   * RECOMMENDATIONS
   * ============================================================
   */

  const normalRecommendations =
    buildRecommendations(
      data
    );


  /*
   * Merge:
   *
   * Existing recommendations
   * +
   * EBS
   * +
   * AMI
   * +
   * Snapshot
   */

  data.recommendations = [

    ...normalRecommendations,

    ...finopsRecommendations

  ];


  /*
   * Sort final recommendations
   */

  const priorityOrder = {

    HIGH: 0,

    MEDIUM: 1,

    LOW: 2

  };


  data.recommendations.sort(
    (a, b) =>

      priorityOrder[a.priority] -
      priorityOrder[b.priority] ||

      (
        b.monthlySaving || 0
      ) -
      (
        a.monthlySaving || 0
      )
  );


  return data;

}


/*
