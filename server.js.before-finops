// CLOUDWATCH IDLE RESOURCE DETECTION
// ─────────────────────────────────────────────

async function fetchIdleResources(
  region,
  ec2Instances,
  rdsInstances
) {

  console.log(
    `CloudWatch idle analysis: ${ec2Instances.length} EC2, ${rdsInstances.length} RDS`
  );


  const idleEC2 = [];

  const idleRDS = [];


  // ─────────────────────────────────────────
  // EC2
  // ─────────────────────────────────────────

  for (
    const instance of ec2Instances
  ) {

    try {

      const metrics =
        await getEC2IdleMetrics(
          region,
          instance.instanceId,
          30
        );


      if (
        isEC2Idle(metrics)
      ) {

        idleEC2.push({

          ...instance,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          maxCpu:
            Number(
              metrics.maxCpu.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          avgDiskReadOps:
            Number(
              metrics.avgDiskReadOps.toFixed(2)
            ),

          avgDiskWriteOps:
            Number(
              metrics.avgDiskWriteOps.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });
      }

    } catch (error) {

      console.warn(
        `EC2 CloudWatch failed for ${instance.instanceId}:`,
        error.message
      );
    }
  }


  // ─────────────────────────────────────────
  // RDS
  // ─────────────────────────────────────────

  for (
    const database of rdsInstances
  ) {

    try {

      const metrics =
        await getRDSIdleMetrics(
          region,
          database.identifier,
          30
        );


      if (
        isRDSIdle(metrics)
      ) {

        idleRDS.push({

          ...database,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          avgConnections:
            Number(
              metrics.avgConnections.toFixed(2)
            ),

          avgReadIOPS:
            Number(
              metrics.avgReadIOPS.toFixed(2)
            ),

          avgWriteIOPS:
            Number(
              metrics.avgWriteIOPS.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });
      }

    } catch (error) {

      console.warn(
        `RDS CloudWatch failed for ${database.identifier}:`,
        error.message
      );
    }
  }


  return {

    ec2:
      idleEC2,

    rds:
      idleRDS

  };
}


