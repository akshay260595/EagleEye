   */

  data.recommendations =
    buildRecommendations(data);


  return data;
}


// ── CACHE ──

const cache = {};

const TTL =
  15 * 60 * 1000;


async function getCached(
  region,
  year,
  month
) {

  const key =
    `${region}_${year}_${month}`;


  if (
    cache[key] &&
    Date.now() -
      cache[key].ts <
      TTL
  ) {

    return cache[key].data;
  }


  const data =
    await fetchAllData(
      region,
      year,
      month
    );


  cache[key] = {

    data,

    ts:
      Date.now()

  };


  return data;
}


