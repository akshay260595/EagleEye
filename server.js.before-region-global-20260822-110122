/*
 * ============================================================
 * DAILY SERVICE COST API
 * ============================================================
 */

app.get(
  '/api/service-daily',
  async (
    req,
    res
  ) => {

    const region =
      req.query.region ||
      'us-east-1';


    const year =
      parseInt(
        req.query.year,
        10
      ) ||
      new Date()
        .getFullYear();


    const month =

      req.query.month !== undefined

        ? parseInt(
            req.query.month,
            10
          )

        : new Date()
            .getMonth();


    const service =
      req.query.service ||
      '';


    if (
      !service
    ) {

      return res
        .status(
          400
        )
        .json({

          error:
            'service param required'

        });

    }


    const {
      ce
    } =
      getClients(
        region
      );


    const now =
      new Date();


    const start =
      new Date(
        year,
        month,
        1
      );


    const isCurrentMonth =
      year ===
        now.getFullYear() &&

      month ===
        now.getMonth();


    const end =

      isCurrentMonth

        ? new Date(
            year,
            month,
            now.getDate() + 1
          )

        : new Date(
            year,
            month + 1,
            1
          );


    const formatDate =
      date =>
        date
          .toISOString()
          .split('T')[0];


    try {

      const response =
        await ce.send(
          new GetCostAndUsageCommand({

            TimePeriod: {

              Start:
                formatDate(
                  start
                ),

              End:
                formatDate(
                  end
                )

            },

            Granularity:
              'DAILY',

            Metrics: [
              'UnblendedCost'
            ],

            Filter: {

              Dimensions: {

                Key:
                  'SERVICE',

                Values: [
                  service
                ]

              }

            }

          })
        );


      const days =
        (
          response.ResultsByTime ||
          []
        ).map(
          result => ({

            date:
              result
                .TimePeriod
                .Start,

            cost:
              Number(
                parseFloat(
                  result.Total
                    ?.UnblendedCost
                    ?.Amount ||
                    '0'
                ).toFixed(4)
              )

          })
        );


      res.json({

        service,

        year,

        month,

        days

      });


    } catch (error) {

      console.error(
        'daily cost error:',
        error.message
      );


      res
        .status(
          500
        )
        .json({

          error:
            error.message

        });

    }

  }
);


