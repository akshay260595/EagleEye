) {

  try {

    const [
      vpcs,
      subnets,
      natGateways,
      internetGateways,
      securityGroups,
      keyPairs
    ] =
      await Promise.all([

        ec2.send(
          new DescribeVpcsCommand({})
        ),

        ec2.send(
          new DescribeSubnetsCommand({})
        ),

        ec2.send(
          new DescribeNatGatewaysCommand({

            Filter: [
              {
                Name:
                  'state',

                Values: [
                  'available'
                ]
              }
            ]

          })
        ),

        ec2.send(
          new DescribeInternetGatewaysCommand({})
        ),

        ec2.send(
          new DescribeSecurityGroupsCommand({})
        ),

        ec2.send(
          new DescribeKeyPairsCommand({})
        )

      ]);


    const allSubnets =
      subnets.Subnets ||
      [];


    const publicSubnets =
      allSubnets.filter(
        subnet =>
          subnet.MapPublicIpOnLaunch
      ).length;


    return {

      vpcs:
        (
          vpcs.Vpcs ||
          []
        ).length,

      subnets: {

        total:
          allSubnets.length,

        public:
          publicSubnets,

        private:
          allSubnets.length -
          publicSubnets

      },

      natGateways:
        (
          natGateways.NatGateways ||
          []
        ).length,

      internetGateways:
        (
          internetGateways.InternetGateways ||
          []
        ).length,

      securityGroups:
        (
          securityGroups.SecurityGroups ||
          []
        ).length,

      keyPairs:
        (
          keyPairs.KeyPairs ||
          []
        ).length

    };

  } catch (error) {

    console.warn(
      'VPC:',
      error.message
    );


    return {

      vpcs:
        0,

      subnets: {

        total:
          0,

        public:
          0,

        private:
          0

      },

      natGateways:
        0,

      internetGateways:
        0,

      securityGroups:
        0,

      keyPairs:
        0

    };

  }

}


