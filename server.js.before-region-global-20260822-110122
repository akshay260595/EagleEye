const clientCache = {};


function getClients(region) {

  if (
    clientCache[region]
  ) {

    return clientCache[region];

  }


  const cfg = {
    region
  };


  clientCache[region] = {

    ce:
      new CostExplorerClient({
        region: 'us-east-1'
      }),

    ec2:
      new EC2Client(cfg),

    s3:
      new S3Client(cfg),

    sts:
      new STSClient(cfg),

    elb:
      new ElasticLoadBalancingV2Client(cfg),

    rds:
      new RDSClient(cfg),

    logs:
      new CloudWatchLogsClient(cfg),

    cloudtrail:
      new CloudTrailClient(cfg)

  };


  return clientCache[region];
}


/*
 * ============================================================
 * DATE HELPERS
 * ============================================================
 */

const fmtDate =
  d =>
    d.toISOString().split('T')[0];


function monthRange(
  year,
  month
) {

  const now =
    new Date();


  const isCurrentMonth =
    year === now.getFullYear() &&
    month === now.getMonth();


  const pad =
    n =>
      String(n).padStart(2, '0');


  const start =
    `${year}-${pad(month + 1)}-01`;


  let end;


  if (
    isCurrentMonth
  ) {

    const tomorrow =
      new Date(
        now.getFullYear(),
        now.getMonth(),
        now.getDate() + 1
      );


    end =
      fmtDate(
        tomorrow
      );

  } else {

    end =
      fmtDate(
        new Date(
          year,
          month + 1,
          1
        )
      );

  }


  const lastDay =
    new Date(
      year,
      month + 1,
      0
    ).getDate();


  const displayEnd =
    isCurrentMonth

      ? `${year}-${pad(month + 1)}-${pad(now.getDate())}`

      : `${year}-${pad(month + 1)}-${pad(lastDay)}`;


  return {

    start,

    end,

    displayStart:
      start,

    displayEnd,

    isCurrentMonth

  };

}


function yearRange(year) {

  const now =
    new Date();


  const y =
    year ||
    now.getFullYear();


  const end =
    y === now.getFullYear()

      ? new Date(
          now.getFullYear(),
          now.getMonth() + 1,
          1
        )

      : new Date(
          y + 1,
          0,
          1
        );


  return {

    start:
      `${y}-01-01`,

    end:
      fmtDate(
        end
      )

  };

}


/*
 * ============================================================
 * COST EXPLORER
 * ============================================================
 */

async function ceCostByService(
  ce,
  start,
  end
) {

  try {

    const response =
      await ce.send(
        new GetCostAndUsageCommand({

          TimePeriod: {
            Start: start,
            End: end
          },

          Granularity:
            'MONTHLY',

          Metrics: [
            'UnblendedCost'
          ],

          GroupBy: [
            {
              Type:
                'DIMENSION',

              Key:
                'SERVICE'
            }
          ]

        })
      );


    return (
      response.ResultsByTime || []
    )
      .flatMap(
        r =>
          r.Groups || []
      )
      .reduce(
        (
          acc,
          group
        ) => {

          const cost =
            parseFloat(
              group.Metrics
                ?.UnblendedCost
                ?.Amount || '0'
            );


          if (
            cost > 0.005
          ) {

            const service =
              group.Keys?.[0] ||
              'Unknown';


            acc[service] =
              (
                acc[service] ||
                0
              ) + cost;

          }


          return acc;

        },
        {}
      );

  } catch (error) {

    console.warn(
      'CE services:',
      error.message
    );


    return {};

  }

}


async function ceMonthlyTotals(
  ce,
  year
) {

  const {
    start,
    end
  } =
    yearRange(year);


  try {

    const response =
      await ce.send(
        new GetCostAndUsageCommand({

          TimePeriod: {
            Start: start,
            End: end
          },

          Granularity:
            'MONTHLY',

          Metrics: [
            'UnblendedCost'
          ]

        })
      );


    const months = [

      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec'

    ];


    return (
      response.ResultsByTime || []
    ).map(
      result => ({

        month:
          months[
            new Date(
              result.TimePeriod.Start
            ).getMonth()
          ],

        amount:
          Number(
            parseFloat(
              result.Total
                ?.UnblendedCost
                ?.Amount || '0'
            ).toFixed(2)
          )

      })
    );

  } catch (error) {

    console.warn(
      'CE monthly:',
      error.message
    );


    return [];

  }

}


