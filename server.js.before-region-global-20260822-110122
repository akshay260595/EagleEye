/*
 * ============================================================
 * AMI OPTIMIZATION
 * ============================================================
 */

async function fetchAMIOptimization(
  ec2,
  days = 90
) {

  try {

    const response =
      await ec2.send(
        new DescribeImagesCommand({

          Owners: [
            'self'
          ]

        })
      );


    const images =
      response.Images ||
      [];


    const cutoff =
      Date.now() -
      (
        days *
        86400000
      );


    const candidates =
      images

        .filter(
          image => {

            if (
              !image.CreationDate
            ) {

              return false;

            }


            return (
              new Date(
                image.CreationDate
              ).getTime() <
              cutoff
            );

          }
        )

        .map(
          image => ({

            imageId:
              image.ImageId,

            name:
              image.Name ||
              '',

            creationDate:
              image.CreationDate,

            ageDays:
              Math.floor(
                (
                  Date.now() -
                  new Date(
                    image.CreationDate
                  ).getTime()
                ) /
                86400000
              ),

            state:
              image.State,

            description:
              image.Description ||
              ''

          })
        );


    return {

      total:
        images.length,

      olderThan90Days:
        candidates.length,

      candidates

    };

  } catch (error) {

    console.warn(
      'AMI optimization:',
      error.message
    );


    return {

      total:
        0,

      olderThan90Days:
        0,

      candidates:
        [],

      error:
        error.message

    };

  }

}


/*
 * ============================================================
 * SNAPSHOT OPTIMIZATION
 * ============================================================
 */

async function fetchSnapshotOptimization(
  ec2,
  days = 90
) {

  try {

    const [
      snapshotResponse,
      volumeResponse
    ] =
      await Promise.all([

        ec2.send(
          new DescribeSnapshotsCommand({

            OwnerIds: [
              'self'
            ]

          })
        ),

        ec2.send(
          new DescribeVolumesCommand({

            MaxResults:
              500

          })
        )

      ]);


    const snapshots =
      snapshotResponse.Snapshots ||
      [];


    const volumes =
      volumeResponse.Volumes ||
      [];


    const volumeIds =
      new Set(
        volumes.map(
          volume =>
            volume.VolumeId
        )
      );


    const cutoff =
      Date.now() -
      (
        days *
        86400000
      );


    const oldSnapshots =
      snapshots.filter(
        snapshot =>

          snapshot.StartTime &&

          new Date(
            snapshot.StartTime
          ).getTime() <
          cutoff
      );


    const orphaned =
      snapshots.filter(
        snapshot =>

          snapshot.VolumeId &&

          !volumeIds.has(
            snapshot.VolumeId
          )
      );


    const oldOrphaned =
      oldSnapshots.filter(
        snapshot =>

          snapshot.VolumeId &&

          !volumeIds.has(
            snapshot.VolumeId
          )
      );


    const mapSnapshot =
      snapshot => ({

        snapshotId:
          snapshot.SnapshotId,

        volumeId:
          snapshot.VolumeId ||
          null,

        startTime:
          snapshot.StartTime,

        ageDays:
          snapshot.StartTime

            ? Math.floor(
                (
                  Date.now() -
                  new Date(
                    snapshot.StartTime
                  ).getTime()
                ) /
                86400000
              )

            : null,

        sizeGB:
          snapshot.VolumeSize ||
          0,

        state:
          snapshot.State

      });


    /*
     * Approximate EBS snapshot
     * storage price.
     *
     * This is only an estimate.
     */
    const pricePerGBMonth =
      0.05;


    const oldCost =
      oldSnapshots.reduce(
        (
          sum,
          snapshot
        ) =>
          sum +
          (
            snapshot.VolumeSize ||
            0
          ) *
          pricePerGBMonth,
        0
      );


    const orphanCost =
      orphaned.reduce(
        (
          sum,
          snapshot
        ) =>
          sum +
          (
            snapshot.VolumeSize ||
            0
          ) *
          pricePerGBMonth,
        0
      );


    const cleanupCost =
      oldOrphaned.reduce(
        (
          sum,
          snapshot
        ) =>
          sum +
          (
            snapshot.VolumeSize ||
            0
          ) *
          pricePerGBMonth,
        0
      );


    return {

      total:
        snapshots.length,

      olderThan90Days:
        oldSnapshots.length,

      orphaned:
        orphaned.length,

      oldOrphaned:
        oldOrphaned.length,

      candidates:
        oldSnapshots.map(
          mapSnapshot
        ),

      orphanedSnapshots:
        orphaned.map(
          mapSnapshot
        ),

      oldOrphanedSnapshots:
        oldOrphaned.map(
          mapSnapshot
        ),

      olderThan90DaysEstimatedMonthlyCost:
        Number(
          oldCost.toFixed(2)
        ),

      orphanedEstimatedMonthlyCost:
        Number(
          orphanCost.toFixed(2)
        ),

      cleanupEstimatedMonthlyCost:
        Number(
          cleanupCost.toFixed(2)
        )

    };

  } catch (error) {

    console.warn(
      'Snapshot optimization:',
      error.message
    );


    return {

      total:
        0,

      olderThan90Days:
        0,

      orphaned:
        0,

      oldOrphaned:
        0,

      candidates:
        [],

      orphanedSnapshots:
        [],

      oldOrphanedSnapshots:
        [],

      olderThan90DaysEstimatedMonthlyCost:
        0,

      orphanedEstimatedMonthlyCost:
        0,

      cleanupEstimatedMonthlyCost:
        0,

      error:
        error.message

    };

  }

}


