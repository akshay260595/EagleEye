      sp.estimatedMonthlySavings

    );

  }


  if (
    ri.estimatedMonthlySavings > 0
  ) {

    add(

      'Review Reserved Instance recommendation',

      'Cost Explorer returned an EC2 Reserved Instance recommendation.',

      'HIGH',

      ri.estimatedMonthlySavings

    );

  }


  const priorityOrder = {

    HIGH:
      0,

    MEDIUM:
      1,

    LOW:
      2

  };


  findings.sort(

    (a, b) =>

      priorityOrder[a.priority] -
      priorityOrder[b.priority] ||

      b.estimatedMonthlySavings -
      a.estimatedMonthlySavings

  );


  const estimatedSavings =
    findings.reduce(

      (
        sum,
        item
      ) =>
        sum +
        item.estimatedMonthlySavings,

      0

    );


  return {

    engine:
      'rule-based-finops-baseline',

    readyForLLM:
      true,

    estimatedMonthlySavings:
      Number(
        estimatedSavings.toFixed(2)
      ),

    topRecommendations:
      findings.slice(
        0,
        10
      ),

    executiveSummary:

      findings.length

        ? `Top priority is ${findings[0].title}. Review the listed resource evidence before applying any remediation.`

        : 'No high-confidence optimization finding was detected by the current rules.'

  };

}


/*
 * ============================================================
 * FETCH ALL DATA
 * ============================================================
 */

async function fetchAllData(
  region,
  year,
  month
) {

  const {
    ce,
    ec2,
    s3,
    sts,
    elb,
    rds,
    logs,
    cloudtrail
  } =
    getClients(region);


  const now =
    new Date();


  const billingYear =
    year ||
    now.getFullYear();


  const billingMonth =

    month !== undefined &&
    month !== null

      ? month

      : now.getMonth();


  console.log(
    `Fetching — region:${region} year:${billingYear} month:${billingMonth}`
  );


  const selected =
    monthRange(
      billingYear,
      billingMonth
    );


  const previous =

    billingMonth === 0

      ? monthRange(
          billingYear - 1,
          11
        )

      : monthRange(
          billingYear,
          billingMonth - 1
        );


  previous.end =
    fmtDate(
      new Date(
        billingYear,
        billingMonth,
        1
      )
    );


  const previous2 =

    billingMonth <= 1

      ? monthRange(

          billingYear - 1,

          billingMonth === 0
            ? 10
            : 11

        )

      : monthRange(
          billingYear,
          billingMonth - 2
        );


  previous2.end =
    fmtDate(
      new Date(
        billingYear,
        billingMonth - 1,
        1
      )
    );


  const [

    identity,

    selectedMap,

    previousMap,

    previous2Map,

    monthlyData,

    ec2Stats,

    elasticIPs,

    volumes,

    vpcStats,

    albStats,

    s3Buckets,

    rdsStats,

    amiOptimization,

    snapshotOptimization,

    s3Optimization,

    cloudwatchLogs,

    cloudTrail,

    savingsPlans,

    reservedInstances

  ] =

    await Promise.all([

      sts
        .send(
          new GetCallerIdentityCommand({})
        )
        .catch(
          () => ({
            Account:
              'N/A'
          })
        ),

      ceCostByService(
        ce,
        selected.start,
        selected.end
      ),

      ceCostByService(
        ce,
        previous.start,
        previous.end
      ),

      ceCostByService(
        ce,
        previous2.start,
        previous2.end
      ),

      ceMonthlyTotals(
        ce,
        billingYear
      ),

      fetchEC2Stats(
        ec2
      ),

      fetchElasticIPs(
        ec2
      ),

      fetchVolumes(
        ec2
      ),

      fetchVPCStats(
        ec2
      ),

      fetchALBStats(
        elb
      ),

      fetchS3Count(
        s3
      ),

      fetchRDSStats(
        rds
      ),

      fetchAMIOptimization(
        ec2,
        90
      ),

      fetchSnapshotOptimization(
        ec2,
        90
      ),

      fetchS3Optimization(
        s3
      ),

      fetchCloudWatchRetention(
        logs
      ),

      fetchCloudTrailOptimization(
        cloudtrail
      ),

      getSavingsPlanRecommendation(
        ce
      ),

      getReservedInstanceRecommendation(
        ce
      )

    ]);


  const services =
    toList(
      selectedMap
    );


  const lastMonthServices =
    toList(
      previousMap
    );


  const twoMonthsAgoServices =
    toList(
      previous2Map
    );


  const currentMonthTotal =
    Number(
      services
        .reduce(
          (
            sum,
            item
          ) =>
            sum +
            item.cost,

          0
        )
        .toFixed(2)
    );


  /*
   * ============================================================
   * CLOUDWATCH IDLE
   * ============================================================
   */

  const idleResources =
    await fetchIdleResources(

      region,

      ec2Stats.instances ||
        [],

      rdsStats.instances ||
        []

    );


  /*
   * ============================================================
   * FINOPS EBS
   * ============================================================
   */

  let finops = {};

  let finopsRecommendations = [];


  try {

    finops =
      await analyzeEBS(
        ec2
      );


    finopsRecommendations =
      buildEBSRecommendations(
        finops
      );

  } catch (error) {

    console.warn(
      'FinOps EBS:',
      error.message
    );

  }


  const MONTH_NAMES = [

    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'

  ];


  const billingPeriod =

    selected.isCurrentMonth

      ? `${MONTH_NAMES[billingMonth]} 1 – ${now.getDate()} (MTD)`

      : `${MONTH_NAMES[billingMonth]} ${billingYear} (Full Month)`;


  const infraStats = {

    ec2:
      ec2Stats,

    elasticIPs,

    volumes,

    s3Buckets,

    rds:
      rdsStats,

    vpcs:
      vpcStats.vpcs,

    subnets:
      vpcStats.subnets,

    natGateways:
      vpcStats.natGateways,

    internetGateways:
      vpcStats.internetGateways,

    securityGroups:
      vpcStats.securityGroups,

    keyPairs:
      vpcStats.keyPairs,

    alb:
      albStats

  };


  /*
   * ============================================================
   * OPTIMIZATION OBJECT
   * ============================================================
   */

  const optimization = {

    ebs:
      finops,

    ami:
      finops.ami ||
      amiOptimization,

    snapshots:
      finops.snapshots ||
      snapshotOptimization,

    s3:
      s3Optimization,

    cloudwatchLogs,

    cloudTrail,

    savingsPlans,

    reservedInstances

  };


  const data = {

    accountId:
      identity.Account,

    billingPeriod,

    region,

    billingYear,

    billingMonth,

    isCurrentMonth:
      selected.isCurrentMonth,

    currentMonthTotal,


    dateRange: {

      start:
        selected.displayStart,

      end:
        selected.displayEnd

    },


    prevMonthRange: {

      start:
        previous.start,

      end:
        previous.end

    },


    prev2MonthRange: {

      start:
        previous2.start,

      end:
        previous2.end

    },


    services,

    lastMonthServices,

    twoMonthsAgoServices,

    monthlyData,

    infraStats,


    /*
     * CloudWatch idle resources
     */
    idleResources,


    /*
     * FinOps optimization
     */
    optimization,


    fetchedAt:
      new Date().toISOString()

  };


  /*
   * ============================================================
   * RECOMMENDATIONS
   * ============================================================
   */

  const normalRecommendations =
    buildRecommendations(
      data
    );


  data.recommendations = [

    ...normalRecommendations,

    ...finopsRecommendations

  ];


  const priorityOrder = {

    HIGH:
      0,

    MEDIUM:
      1,

    LOW:
      2

  };


  data.recommendations.sort(

    (a, b) =>

      priorityOrder[a.priority] -
      priorityOrder[b.priority] ||

      (
        b.monthlySaving ||
        0
      ) -
      (
        a.monthlySaving ||
        0
      )

  );


  /*
   * AI recommendation layer
   */
  data.aiRecommendations =
    buildAIRecommendationSummary(
      data
    );


  return data;

}


/*
 * ============================================================
 * CACHE
 * ============================================================
 */

const cache = {};

const TTL =
  15 * 60 * 1000;


async function getCached(
  region,
  year,
  month
) {

  const key =
    `${region}_${year}_${month}`;


  if (

    cache[key] &&

    Date.now() -
      cache[key].ts <
      TTL

  ) {

    return cache[key].data;

  }


  const data =
    await fetchAllData(
      region,
      year,
      month
    );


  cache[key] = {

    data,

    ts:
      Date.now()

  };


  return data;

}


