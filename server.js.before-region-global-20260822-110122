    const results =
      await Promise.all(

        buckets.map(
          async bucket => {

            const name =
              bucket.Name;


            let bucketRegion =
              'us-east-1';


            let lifecycle =
              false;


            let versioning =
              'Unknown';


            /*
             * Determine bucket region
             */
            try {

              const locationResponse =
                await s3.send(
                  new GetBucketLocationCommand({

                    Bucket:
                      name

                  })
                );


              bucketRegion =
                locationResponse.LocationConstraint ||
                'us-east-1';


              if (
                bucketRegion ===
                'EU'
              ) {

                bucketRegion =
                  'eu-west-1';

              }

            } catch (error) {

              bucketRegion =
                'us-east-1';

            }


            const bucketClient =
              new S3Client({

                region:
                  bucketRegion

              });


            /*
             * Lifecycle
             */
            try {

              const lifecycleResponse =
                await bucketClient.send(
                  new GetBucketLifecycleConfigurationCommand({

                    Bucket:
                      name

                  })
                );


              lifecycle =
                (
                  lifecycleResponse.Rules ||
                  []
                ).length > 0;

            } catch (error) {

              lifecycle =
                false;

            }


            /*
             * Versioning
             */
            try {

              const versioningResponse =
                await bucketClient.send(
                  new GetBucketVersioningCommand({

                    Bucket:
                      name

                  })
                );


              versioning =
                versioningResponse.Status ||
                'Disabled';

            } catch (error) {

              versioning =
                'Unknown';

            }


            return {

              bucket:
                name,

              region:
                bucketRegion,

              lifecycleConfigured:
                lifecycle,

              versioning

            };

          }
        )

      );


    const withoutLifecycle =
      results.filter(
        bucket =>
          !bucket.lifecycleConfigured
      );


    return {

      total:
        results.length,

      withoutLifecycle:
        withoutLifecycle.length,

      versioned:
        results.filter(
          bucket =>
            bucket.versioning ===
            'Enabled'
        ).length,

      buckets:
        results

    };

  } catch (error) {

    console.warn(
      'S3 optimization:',
      error.message
    );


    return {

      total:
        0,

      withoutLifecycle:
        0,

      versioned:
        0,

      buckets:
        [],

      error:
        error.message

    };

  }

}


/*
 * ============================================================
 * RDS
 * ============================================================
 */

async function fetchRDSStats(
  rds
) {

  try {

    let instances = [];

    let marker;


    do {

      const response =
        await rds.send(
          new DescribeDBInstancesCommand({

            Marker:
              marker,

            MaxRecords:
              100

          })
        );


      instances.push(
        ...(
          response.DBInstances ||
          []
        )
      );


      marker =
        response.Marker;


    } while (
      marker
    );


    const available =
      instances.filter(
        instance =>
          instance.DBInstanceStatus ===
          'available'
      ).length;


    const stopped =
      instances.filter(
        instance =>
          instance.DBInstanceStatus ===
          'stopped'
      ).length;


    const engines = {};


    for (
      const instance of instances
    ) {

      const engine =
        instance.Engine ||
        'unknown';


      engines[engine] =
        (
          engines[engine] ||
          0
        ) + 1;

    }


    const multiAZ =
      instances.filter(
        instance =>
          instance.MultiAZ
      ).length;


    return {

      total:
        instances.length,

      available,

      stopped,

      engines,

      multiAZ,

      nonMultiAZ:
        instances.length -
        multiAZ,

      gp2Storage:
        instances.filter(
          instance =>
            instance.StorageType ===
            'gp2'
        ).length,

      stoppedIds:
        instances

          .filter(
            instance =>
              instance.DBInstanceStatus ===
              'stopped'
          )

          .map(
            instance =>
              instance.DBInstanceIdentifier
          ),

      instances:
        instances

          .filter(
            instance =>
              instance.DBInstanceStatus ===
              'available'
          )

          .map(
            instance => ({

              identifier:
                instance.DBInstanceIdentifier,

              instanceClass:
                instance.DBInstanceClass,

              engine:
                instance.Engine,

              status:
                instance.DBInstanceStatus,

              multiAZ:
                instance.MultiAZ,

              storageType:
                instance.StorageType

            })
          )

    };

  } catch (error) {

    console.warn(
      'RDS:',
      error.message
    );


    return {

      total:
        0,

      available:
        0,

      stopped:
        0,

      engines:
        {},

      multiAZ:
        0,

      nonMultiAZ:
        0,

      gp2Storage:
        0,

      stoppedIds:
        [],

      instances:
        []

    };

  }

}


/*
 * ============================================================
 * CLOUDWATCH IDLE ANALYSIS
 *
 * IMPORTANT:
 *
 * EC2/RDS idle detection comes from CloudWatch metrics.
 *
 * It does NOT use:
 *
 * - Compute Optimizer
 * - Trusted Advisor
 *
 * ============================================================
 */

async function fetchIdleResources(
  region,
  ec2Instances,
  rdsInstances
) {

  console.log(
    `CloudWatch idle analysis: ${ec2Instances.length} EC2, ${rdsInstances.length} RDS`
  );


  const idleEC2 = [];

  const idleRDS = [];


  /*
   * EC2
   */

  for (
    const instance of ec2Instances
  ) {

    try {

      const metrics =
        await getEC2IdleMetrics(
          region,
          instance.instanceId,
          30
        );


      if (
        isEC2Idle(
          metrics
        )
      ) {

        idleEC2.push({

          ...instance,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          maxCpu:
            Number(
              metrics.maxCpu.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          avgDiskReadOps:
            Number(
              metrics.avgDiskReadOps.toFixed(2)
            ),

          avgDiskWriteOps:
            Number(
              metrics.avgDiskWriteOps.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });

      }

    } catch (error) {

      console.warn(
        `EC2 CloudWatch failed for ${instance.instanceId}:`,
        error.message
      );

    }

  }


  /*
   * RDS
   */

  for (
    const database of rdsInstances
  ) {

    try {

      const metrics =
        await getRDSIdleMetrics(
          region,
          database.identifier,
          30
        );


      if (
        isRDSIdle(
          metrics
        )
      ) {

        idleRDS.push({

          ...database,

          avgCpu:
            Number(
              metrics.avgCpu.toFixed(2)
            ),

          avgConnections:
            Number(
              metrics.avgConnections.toFixed(2)
            ),

          avgReadIOPS:
            Number(
              metrics.avgReadIOPS.toFixed(2)
            ),

          avgWriteIOPS:
            Number(
              metrics.avgWriteIOPS.toFixed(2)
            ),

          avgNetworkIn:
            Number(
              metrics.avgNetworkIn.toFixed(2)
            ),

          avgNetworkOut:
            Number(
              metrics.avgNetworkOut.toFixed(2)
            ),

          evaluationDays:
            metrics.evaluationDays

        });

      }

    } catch (error) {

      console.warn(
        `RDS CloudWatch failed for ${database.identifier}:`,
        error.message
      );

    }

  }


  return {

    ec2:
      idleEC2,

    rds:
      idleRDS

  };

}


/*
 * ============================================================
 * CLOUDWATCH LOG RETENTION
 * ============================================================
 */

async function fetchCloudWatchRetention(
  logs
) {

  try {

    let groups = [];

    let nextToken;


    do {

      const response =
        await logs.send(
          new DescribeLogGroupsCommand({

            nextToken,

            limit:
              50

          })
        );


      groups.push(
        ...(
          response.logGroups ||
          []
        )
      );


      nextToken =
        response.nextToken;


    } while (
      nextToken
    );


    const noRetention =
      groups.filter(
        group =>
          group.retentionInDays ===
          undefined
      );


    return {

      total:
        groups.length,

      withoutRetention:
        noRetention.length,

      configured:
        groups.length -
        noRetention.length,

      groupsWithoutRetention:
        noRetention.map(
          group => ({

            logGroupName:
              group.logGroupName,

            storedBytes:
              group.storedBytes ||
              0

          })
        )

    };

  } catch (error) {

    console.warn(
      'CloudWatch retention:',
      error.message
    );


    return {

      total:
        0,

      withoutRetention:
        0,

      configured:
        0,

      groupsWithoutRetention:
        [],

      error:
        error.message

    };

  }

}


/*
 * ============================================================
 * CLOUDTRAIL DUPLICATE TRAILS
 * ============================================================
 */

async function fetchCloudTrailOptimization(
  cloudtrail
) {

  try {

    const response =
      await cloudtrail.send(
        new DescribeTrailsCommand({

          includeShadowTrails:
            true

        })
      );


    const trails =
      response.trailList ||
      [];


    const byBucket = {};


    for (
      const trail of trails
    ) {

      const bucket =
        trail.S3BucketName ||
        'NO_BUCKET';


      if (
        !byBucket[bucket]
      ) {

        byBucket[bucket] =
          [];

      }


      byBucket[bucket].push(
        trail
      );

    }


    const duplicateGroups =
      Object.entries(
        byBucket
      )

        .filter(
          ([, list]) =>
            list.length > 1
        )

        .map(
          ([bucket, list]) => ({

            bucket,

            count:
              list.length,

            trails:
              list.map(
                trail => ({

                  name:
                    trail.Name,

                  homeRegion:
                    trail.HomeRegion,

                  isMultiRegionTrail:
                    !!trail.IsMultiRegionTrail,

                  isOrganizationTrail:
                    !!trail.IsOrganizationTrail

                })
              )

          })
        );


    const duplicateCount =
      duplicateGroups.reduce(
        (
          sum,
          group
        ) =>
          sum +
          Math.max(
            0,
            group.count - 1
          ),
        0
      );


    return {

      total:
        trails.length,

      duplicateCount,

      duplicateGroups,

      trails:
        trails.map(
          trail => ({

            name:
              trail.Name,

            s3BucketName:
              trail.S3BucketName,

            homeRegion:
              trail.HomeRegion,

            isMultiRegionTrail:
              !!trail.IsMultiRegionTrail,

            isOrganizationTrail:
              !!trail.IsOrganizationTrail

          })
        )

    };

  } catch (error) {

    console.warn(
      'CloudTrail:',
      error.message
    );


    return {

      total:
        0,

      duplicateCount:
        0,

      duplicateGroups:
        [],

      trails:
        [],

      error:
        error.message

    };

  }

}


